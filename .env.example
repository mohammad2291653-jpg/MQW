# Local development and isolated tests use SQLite. Never commit real data.
MQW_STORAGE_BACKEND=sqlite
MQW_DATA_DIR=./data
# Free cloud runtime: set MQW_STORAGE_BACKEND=postgres in private host settings.
# PostgreSQL holds both application records and bounded audio; no local disk or
# Supabase Storage bucket is used by this runtime. MQW_DATA_DIR is then unused.
# Obtain the actual Session Pooler host from Supabase Connect; do not infer it
# from the project region. Use port 5432 and the restricted runtime role.
# MQW_DATABASE_URL=postgresql://mqw_app.PROJECT_REF:URL_ENCODED_PASSWORD@ACTUAL_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
# The server driver always verifies TLS. If the server certificate requires an
# additional CA, bind its PEM privately as MQW_DATABASE_CA_CERT (real newlines).
# Never set NODE_TLS_REJECT_UNAUTHORIZED=0 or use sslmode=disable/no-verify.
# Set before any public hosting to restrict registration to your address.
# MQW_OWNER_EMAIL=you@example.com
# Public production also requires a private, one-use setup invitation.
# Generate private material with scripts/prepare-owner-setup.mjs.
# MQW_SETUP_TOKEN_HASH=<64-character SHA-256 digest>
# Fixed public HTTPS origin when running behind a reverse proxy:
# MQW_APP_ORIGIN=https://mqw.example.com
# On Render the startup script can use the platform's RENDER_EXTERNAL_URL.
# Keep MQW_LOCAL_PREVIEW unset for public hosting; it relaxes setup/HTTPS guards.
NEXT_TELEMETRY_DISABLED=1
